{
  "name": "ERP Frontend (Vue 3 + Vite)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bullseye",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
